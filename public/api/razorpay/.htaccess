# Only the checkout and onboarding endpoints are reachable. Blocks lib.php, PHP error_log files and anything else here.
<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "^(create-order|verify-payment|onboarding)\.php$">
    Require all granted
  </FilesMatch>
</IfModule>
Options -Indexes
