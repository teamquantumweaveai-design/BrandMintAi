{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/voice/*.mjs": {
      "supportsCancellation": true,
      "maxDuration": 95
    }
  }
}
