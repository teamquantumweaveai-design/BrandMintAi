# Public frontend build setting: Render HTTPS origin only, no trailing path.
# Copy to .env.local and replace this example AFTER creating the Render service.
# Rebuild and upload the new dist/ files whenever this URL changes.
# NEVER put the OpenAI key in this file or any VITE_ variable.
VITE_VOICE_BACKEND_URL=https://YOUR-RENDER-SERVICE.onrender.com
