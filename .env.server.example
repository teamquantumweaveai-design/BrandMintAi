# Copy this file to .env.server.local in this same folder, beside package.json.
# Add your own OpenAI project API key ONLY to that ignored local/server file.
OPENAI_API_KEY=

# Supported voice choices for this adapter: cedar or marin.
OPENAI_VOICE=cedar

# Development on localhost needs no production settings below.
# Production is disabled unless explicitly enabled with exact HTTPS origins.
VOICE_PROXY_ENABLED=
VOICE_ALLOWED_ORIGINS=

# Optional standalone npm start settings.
VOICE_PORT=8787
VOICE_HOST=127.0.0.1
# Render uses its supplied PORT and the backend binds to 0.0.0.0.
# Add OPENAI_API_KEY and other server settings in Render's Environment page.

# Optional exact IPs of a trusted reverse proxy; blank ignores forwarded headers.
# That proxy MUST overwrite X-Forwarded-For with one actual client IP.
VOICE_TRUSTED_PROXY_IPS=

# Optional safe, bounded stage logs (no keys, audio, text or raw provider errors).
VOICE_DEBUG=false
